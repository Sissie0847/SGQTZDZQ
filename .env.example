# Memene 开放平台 API 配置
# 复制本文件为 .env 后填写真实值(.env 已被 .gitignore 排除)

# 在 https://platform.memene.cn/dashboard/api-keys 创建并复制
MEMENE_API_KEY=sk_memene_xxxxxxxx

# Memene 账号 UUID(账号设置页 sub/id 字段)
MEMENE_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 订阅方案(频道)ID。GET /v1/meme/subscribePlans 拉取,或者从 APP 频道详情页 URL 复制
MEMENE_PLAN_ID=cmxxxxxxxxxxxxxxxxxxxxxxx

# 频道展示名(可选,不填走 API 返回的 planName)
MEMENE_PLAN_NAME=十个勤天

# 一次拉取多少条日报(默认 60 条,约 2 个月内容)
FETCH_LIMIT=60
