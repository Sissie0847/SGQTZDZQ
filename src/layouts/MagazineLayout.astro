---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '禾勤久久 · 十个勤天少年之家',
  description = 'Memene 每天自动整理十个哥哥和助手号的更新,经济学人 magazine 版式呈现。日报 + 日历 + 通知 + 物料,一站汇总。',
} = Astro.props;

// 动态高亮当前 nav
const path = Astro.url.pathname;
const isActive = (p: string) => path === p || path.startsWith(p + '/');
---
<!doctype html>
<html lang="zh-CN" class="magazine-html">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 异步加载,避免国内访问 Google Fonts 阻塞 page load -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap"
      />
    </noscript>

    <style is:global>
      /* 米黄底 + 衬线,覆盖 dark 全站主题 */
      html.magazine-html, html.magazine-html body {
        background: #fdfbf5 !important;
        color: #121212 !important;
        font-family: "Source Serif 4", "Songti SC", "STSong", Georgia, serif;
      }
      html.magazine-html body::before {
        display: none; /* 关掉夜间噪点 */
      }
      /* 主题色 = 麦穗金 #E5A92D。深红留作辅色 */
      .mag-red { color: #E5A92D; }
      .mag-bg-red { background: #E5A92D; }
      .mag-serif { font-family: "Source Serif 4", "Songti SC", "STSong", Georgia, serif; }
      .mag-sans { font-family: "Inter", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; }
      .mag-tab-active {
        color: #E5A92D;
        border-bottom: 3px solid #E5A92D;
        padding-bottom: 6px;
      }
      .mag-tab {
        color: #121212;
        padding-bottom: 6px;
        transition: color .15s;
      }
      .mag-tab:hover { color: #E5A92D; }

      /* 封面顶 banner — 经济学人红方块的等效:麦穗金 */
      .cover-banner {
        background: #E5A92D;
        color: #1a1a1a;
        font-family: "Source Serif 4", "Songti SC", serif;
        font-weight: 700;
        font-style: italic;
        padding: 4px 10px;
        font-size: 1.05rem;
        line-height: 1.05;
        display: inline-block;
      }
      .cover-headline {
        font-family: "Source Serif 4", "Songti SC", serif;
        color: #1a1a1a;
        font-size: 0.62rem;
        line-height: 1.25;
        border-bottom: 1px solid rgba(0,0,0,0.5);
        padding-bottom: 2px;
        margin-bottom: 3px;
      }
      .cover-word {
        font-family: "Source Serif 4", "Songti SC", serif;
        font-weight: 700;
        font-style: italic;
        letter-spacing: -0.04em;
        line-height: 0.9;
        text-align: center;
      }
      .image-lightbox {
        position: fixed;
        inset: 0;
        z-index: 80;
        display: grid;
        place-items: center;
        padding: clamp(12px, 3vw, 32px);
        background: rgba(18, 18, 18, 0.88);
        backdrop-filter: blur(10px);
      }
      .image-lightbox[hidden] {
        display: none !important;
      }
      .image-lightbox__stage {
        position: relative;
        width: min(100%, 1120px);
        height: min(100%, 86vh);
        display: grid;
        place-items: center;
      }
      .image-lightbox__image {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        border: 1px solid rgba(253, 251, 245, 0.22);
        background: #121212;
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
      }
      .image-lightbox__close,
      .image-lightbox__nav {
        border: 1px solid rgba(253, 251, 245, 0.3);
        background: rgba(253, 251, 245, 0.92);
        color: #121212;
        display: grid;
        place-items: center;
        cursor: pointer;
        transition: transform .15s, background .15s, opacity .15s;
      }
      .image-lightbox__close:hover,
      .image-lightbox__nav:hover {
        background: #E5A92D;
        transform: translateY(-1px);
      }
      .image-lightbox__close {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 42px;
        height: 42px;
        border-radius: 999px;
        font-size: 28px;
        line-height: 1;
      }
      .image-lightbox__nav {
        position: absolute;
        top: 50%;
        width: 44px;
        height: 58px;
        margin-top: -29px;
        border-radius: 6px;
        font-size: 34px;
        line-height: 1;
      }
      .image-lightbox__nav[disabled] {
        opacity: .35;
        pointer-events: none;
      }
      .image-lightbox__prev {
        left: 14px;
      }
      .image-lightbox__next {
        right: 14px;
      }
      .image-lightbox__caption {
        position: absolute;
        left: 50%;
        bottom: 14px;
        transform: translateX(-50%);
        max-width: min(92vw, 720px);
        padding: 7px 12px;
        border: 1px solid rgba(253, 251, 245, 0.18);
        background: rgba(18, 18, 18, 0.62);
        color: #fdfbf5;
        font-size: 12px;
        line-height: 1.4;
        text-align: center;
      }
      @media (max-width: 640px) {
        .image-lightbox {
          padding: 8px;
        }
        .image-lightbox__stage {
          height: 82vh;
        }
        .image-lightbox__close {
          top: 10px;
          right: 10px;
          width: 38px;
          height: 38px;
        }
        .image-lightbox__nav {
          width: 38px;
          height: 52px;
        }
        .image-lightbox__prev {
          left: 10px;
        }
        .image-lightbox__next {
          right: 10px;
        }
      }
    </style>
  </head>
  <body class="min-h-screen">
    <!-- 顶部 site-wide nav -->
    <header class="border-b border-[#e0d8c4] px-6 md:px-12 py-4 flex items-center justify-between text-sm">
      <a href="/" class="mag-serif italic font-semibold text-[1.1rem] text-[#121212] hover:mag-red">
        禾勤久久 · 十个勤天少年之家
      </a>
      <nav class="flex gap-6 mag-sans text-[#3a3a3a]">
        <a href="/ai-daily" class={isActive('/ai-daily') ? 'mag-red font-medium' : 'hover:mag-red'}>日报</a>
        <a href="/calendar" class={isActive('/calendar') ? 'mag-red font-medium' : 'hover:mag-red'}>日历</a>
        <a href="/alerts" class={isActive('/alerts') ? 'mag-red font-medium' : 'hover:mag-red'}>通知</a>
        <a href="/materials" class={isActive('/materials') ? 'mag-red font-medium' : 'hover:mag-red'}>物料</a>
        <a href="/tools/chaohua-checkin" class={isActive('/tools') ? 'mag-red font-medium' : 'hover:mag-red'}>工具</a>
        <a href="/about" class={isActive('/about') ? 'mag-red font-medium' : 'hover:mag-red'}>关于</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <!-- Magazine 风 footer -->
    <footer class="mt-32 border-t border-[#e0d8c4] px-6 md:px-12 py-10 mag-sans text-sm text-[#5a5a5a]">
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <span>禾勤久久 · 十个勤天少年之家 · 非官方粉丝站 · 数据来自 Memene 自动整理</span>
          <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener" class="hover:mag-red">浙ICP备2026060100号-1</a>
        </div>
        <div class="flex gap-4">
          <a href="/" class="hover:mag-red">回到主页</a>
          <a href="/about" class="hover:mag-red">关于</a>
        </div>
      </div>
    </footer>

    <div id="image-lightbox" class="image-lightbox" role="dialog" aria-modal="true" hidden>
      <button class="image-lightbox__close" type="button" data-lightbox-close aria-label="Close image">&times;</button>
      <button class="image-lightbox__nav image-lightbox__prev" type="button" data-lightbox-prev aria-label="Previous image">&lsaquo;</button>
      <div class="image-lightbox__stage" data-lightbox-backdrop>
        <img class="image-lightbox__image" data-lightbox-image alt="" />
        <div class="image-lightbox__caption mag-sans" data-lightbox-caption hidden></div>
      </div>
      <button class="image-lightbox__nav image-lightbox__next" type="button" data-lightbox-next aria-label="Next image">&rsaquo;</button>
    </div>

    <script>
      const lightbox = document.getElementById('image-lightbox');
      const lightboxImage = lightbox?.querySelector('[data-lightbox-image]');
      const lightboxCaption = lightbox?.querySelector('[data-lightbox-caption]');
      const closeButton = lightbox?.querySelector('[data-lightbox-close]');
      const prevButton = lightbox?.querySelector('[data-lightbox-prev]');
      const nextButton = lightbox?.querySelector('[data-lightbox-next]');
      const backdrop = lightbox?.querySelector('[data-lightbox-backdrop]');
      let imageLinks = [];
      let activeIndex = 0;

      function collectImageLinks() {
        imageLinks = Array.from(document.querySelectorAll('a[data-image-modal="true"]'));
      }

      function updateLightbox() {
        const link = imageLinks[activeIndex];
        if (!link || !lightbox || !lightboxImage) return;

        const caption = link.getAttribute('data-image-caption') || '';
        lightboxImage.setAttribute('src', link.getAttribute('href') || '');
        lightboxImage.setAttribute('alt', caption);

        if (lightboxCaption) {
          lightboxCaption.textContent = imageLinks.length > 1
            ? `${caption} (${activeIndex + 1}/${imageLinks.length})`
            : caption;
          lightboxCaption.toggleAttribute('hidden', !lightboxCaption.textContent);
        }

        if (prevButton) prevButton.toggleAttribute('disabled', imageLinks.length <= 1);
        if (nextButton) nextButton.toggleAttribute('disabled', imageLinks.length <= 1);
      }

      function openLightbox(index) {
        if (!lightbox) return;
        activeIndex = index;
        updateLightbox();
        lightbox.removeAttribute('hidden');
        document.documentElement.style.overflow = 'hidden';
        closeButton?.focus();
      }

      function closeLightbox() {
        if (!lightbox || !lightboxImage) return;
        lightbox.setAttribute('hidden', '');
        lightboxImage.removeAttribute('src');
        document.documentElement.style.overflow = '';
      }

      function showOffset(offset) {
        if (imageLinks.length <= 1) return;
        activeIndex = (activeIndex + offset + imageLinks.length) % imageLinks.length;
        updateLightbox();
      }

      collectImageLinks();
      imageLinks.forEach((link, index) => {
        link.addEventListener('click', (event) => {
          event.preventDefault();
          openLightbox(index);
        });
      });

      closeButton?.addEventListener('click', closeLightbox);
      prevButton?.addEventListener('click', () => showOffset(-1));
      nextButton?.addEventListener('click', () => showOffset(1));
      backdrop?.addEventListener('click', (event) => {
        if (event.target === backdrop) closeLightbox();
      });
      document.addEventListener('keydown', (event) => {
        if (!lightbox || lightbox.hasAttribute('hidden')) return;
        if (event.key === 'Escape') closeLightbox();
        if (event.key === 'ArrowLeft') showOffset(-1);
        if (event.key === 'ArrowRight') showOffset(1);
      });
    </script>
  </body>
</html>
