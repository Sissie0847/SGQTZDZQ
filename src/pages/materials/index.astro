---
import MagazineLayout from '../../layouts/MagazineLayout.astro';

// v0 占位:物料库。后续可分类拆 ts 文件
type Material = {
  id: string;
  category: '歌单' | '团综' | '直拍' | '周边' | '采访' | '其他';
  title: string;
  cover?: string;
  link: string;
  source?: string;   // 来源(QQ 音乐 / B 站 / 微博 ...)
  note?: string;
};

const materials: Material[] = [
  // 待填
];

const CATEGORIES = ['歌单', '团综', '直拍', '周边', '采访', '其他'] as const;
const byCategory = CATEGORIES.map((c) => ({
  category: c,
  items: materials.filter((m) => m.category === c),
})).filter((g) => g.items.length > 0);

const categoryColor: Record<string, string> = {
  歌单: '#6B8E23',
  团综: '#E5A92D',
  直拍: '#C25B3F',
  周边: '#D95398',
  采访: '#8B6F47',
  其他: '#5a5a5a',
};
---
<MagazineLayout title="物料 · 十个勤天少年之家">
  <section class="px-6 md:px-12 pt-12 pb-4">
    <div class="max-w-6xl mx-auto">
      <p class="mag-sans mag-red text-sm uppercase tracking-widest mb-2">物料库 · 共 {materials.length} 项</p>
      <h1 class="mag-serif text-3xl md:text-5xl text-[#121212] leading-tight">物料</h1>
      <p class="mag-sans text-base text-[#3a3a3a] mt-4 max-w-2xl leading-relaxed">
        歌单、团综、直拍、周边——一键直达。看到啥好的就往这填。
      </p>
    </div>
  </section>

  <section class="px-6 md:px-12 py-10">
    <div class="max-w-6xl mx-auto">
      {byCategory.length === 0 ? (
        <div class="bg-[#fdf6e3] border border-dashed border-[#e0c98c] rounded-lg p-10 text-center">
          <p class="mag-serif text-xl text-[#5a4a2a] mb-2">物料库还没填</p>
          <p class="mag-sans text-sm text-[#7a6a4a]">编辑 <code class="bg-white px-2 py-0.5 rounded">src/pages/materials/index.astro</code> 里的 <code class="bg-white px-2 py-0.5 rounded">materials</code> 数组添加。</p>
        </div>
      ) : (
        byCategory.map((g) => (
          <div class="mb-12">
            <div class="flex items-baseline gap-3 mb-5 border-b border-[#e0d8c4] pb-2">
              <h2 class="mag-serif text-2xl text-[#121212]">{g.category}</h2>
              <span class="text-xs px-2 py-0.5 rounded text-white" style={`background:${categoryColor[g.category]}`}>{g.items.length} 项</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {g.items.map((m) => (
                <a href={m.link} target="_blank" rel="noopener" class="block bg-white border border-[#e0d8c4] rounded-lg p-4 hover:border-[#E5A92D] transition">
                  <div class="flex items-start gap-3">
                    {m.cover && <img src={m.cover} alt="" class="w-16 h-16 rounded object-cover flex-shrink-0" />}
                    <div class="flex-1 min-w-0">
                      <h3 class="mag-serif text-base text-[#121212] leading-snug mb-1">{m.title}</h3>
                      {m.source && <p class="mag-sans text-xs text-[#7a6a4a]">{m.source}</p>}
                      {m.note && <p class="mag-sans text-xs text-[#5a5a5a] mt-2">{m.note}</p>}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))
      )}
    </div>
  </section>
</MagazineLayout>
