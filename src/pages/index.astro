---
import MagazineLayout from '../layouts/MagazineLayout.astro';
import { dailies, formatDateZh } from '../data/dailies';

const latest = [...dailies].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
const totalDailies = dailies.length;
---
<MagazineLayout
  title="禾勤久久 · 十个勤天少年之家"
  description="十个勤天少年之家:Memene 自动整理日报 + 活动日历 + 突发通知 + 物料库,一站汇总。"
>
  <!-- Hero 区 -->
  <section class="px-6 md:px-12 pt-16 md:pt-24 pb-16">
    <div class="max-w-5xl mx-auto">
      <p class="mag-sans mag-red text-sm uppercase tracking-widest mb-3">禾勤久久 · 非官方粉丝站</p>
      <h1 class="mag-serif text-5xl md:text-7xl text-[#121212] leading-tight mb-8">
        十个勤天<br/>少年之家
      </h1>
      <p class="mag-sans text-lg text-[#3a3a3a] max-w-2xl leading-relaxed mb-10">
        Memene 每天自动整理十个哥哥和助手号的更新,做成经济学人 magazine 版式的日报。
        手填的日历追活动、通知收声明、物料库存歌单团综——四件事,一个网站。
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/ai-daily" class="inline-flex items-center gap-2 bg-[#E5A92D] text-[#1a1a1a] px-5 py-3 text-sm font-medium hover:opacity-90">
          <span>看今日日报</span>
          <span class="opacity-60">→</span>
        </a>
        <a href="/calendar" class="inline-flex items-center gap-2 border border-[#c8c0a8] text-[#121212] px-5 py-3 text-sm hover:border-[#E5A92D]">
          活动日历
        </a>
      </div>
    </div>
  </section>

  <!-- 最新 4 期日报预览 -->
  <section class="px-6 md:px-12 py-12 border-t border-[#e0d8c4]">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-end justify-between mb-8 flex-wrap gap-4">
        <div>
          <p class="mag-sans mag-red text-xs uppercase tracking-widest mb-2">最新日报 · 共 {totalDailies} 期</p>
          <h2 class="mag-serif text-3xl text-[#121212]">这周哥哥们在干嘛</h2>
        </div>
        <a href="/ai-daily" class="mag-sans text-sm mag-red underline underline-offset-4">看全部 →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {latest.map((d) => (
          <a href={`/ai-daily/${d.id}`} class="block bg-white border border-[#e0d8c4] p-4 hover:border-[#E5A92D] transition">
            <p class="mag-sans mag-red text-xs mb-2">{formatDateZh(d.date)}{d.week ? ` · ${d.week}` : ''}</p>
            <h3 class="mag-serif text-base text-[#121212] leading-snug mb-3">{d.title}</h3>
            <p class="mag-sans text-xs text-[#5a5a5a] leading-relaxed line-clamp-3">{d.snippet}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 大板块入口 -->
  <section class="px-6 md:px-12 py-16 border-t border-[#e0d8c4]">
    <div class="max-w-5xl mx-auto">
      <p class="mag-sans mag-red text-xs uppercase tracking-widest mb-2">四个板块</p>
      <h2 class="mag-serif text-3xl text-[#121212] mb-10">网站长这样</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <a href="/ai-daily" class="group block bg-[#fdf6e3] border border-[#e0d8c4] p-6 hover:border-[#E5A92D] transition">
          <p class="mag-sans text-xs uppercase tracking-widest text-[#E5A92D] mb-3">01 · Daily</p>
          <h3 class="mag-serif text-2xl text-[#121212] mb-3">日报</h3>
          <p class="mag-sans text-sm text-[#5a5a5a] leading-relaxed">Memene 每天自动抓,经济学人版式呈现。已经有 {totalDailies} 期。</p>
        </a>
        <a href="/calendar" class="group block bg-[#f0e8d4] border border-[#e0d8c4] p-6 hover:border-[#E5A92D] transition">
          <p class="mag-sans text-xs uppercase tracking-widest text-[#6B8E23] mb-3">02 · Calendar</p>
          <h3 class="mag-serif text-2xl text-[#121212] mb-3">日历</h3>
          <p class="mag-sans text-sm text-[#5a5a5a] leading-relaxed">综艺播出、演唱会、直播——手填,这种事 AI 摘要给不准。</p>
        </a>
        <a href="/alerts" class="group block bg-[#fdebd5] border border-[#e0d8c4] p-6 hover:border-[#E5A92D] transition">
          <p class="mag-sans text-xs uppercase tracking-widest text-[#C25B3F] mb-3">03 · Alerts</p>
          <h3 class="mag-serif text-2xl text-[#121212] mb-3">通知</h3>
          <p class="mag-sans text-sm text-[#5a5a5a] leading-relaxed">工作室声明、行程变动、突发好消息——比日报短,比微博更整理。</p>
        </a>
        <a href="/materials" class="group block bg-[#f3ead8] border border-[#e0d8c4] p-6 hover:border-[#E5A92D] transition">
          <p class="mag-sans text-xs uppercase tracking-widest text-[#8B6F47] mb-3">04 · Materials</p>
          <h3 class="mag-serif text-2xl text-[#121212] mb-3">物料</h3>
          <p class="mag-sans text-sm text-[#5a5a5a] leading-relaxed">歌单、团综、直拍、周边——一键直达,看到啥好的就往这填。</p>
        </a>
      </div>
    </div>
  </section>
</MagazineLayout>
